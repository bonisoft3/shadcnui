FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents shell/index.html shell/shell.css shell/boot.js offline-first-sw.js shell/shell.yaml shell/shell.json shell/design.css shell/screens/catalog.html shell/screens/catalog.css shell/screens/switch.html shell/screens/switch.css shell/screens/tabs.html shell/screens/tabs.css shell/screens/picker.html shell/screens/picker.css shell/screens/toggle-group.html shell/screens/toggle-group.css shell/screens/accordion.html shell/screens/accordion.css shell/screens/overlays.html shell/screens/overlays.css shell/screens/primitives.html shell/screens/primitives.css shell/screens/combobox.html shell/screens/combobox.css shell/screens/checkbox.html shell/screens/checkbox.css shell/screens/radio-group.html shell/screens/radio-group.css shell/screens/pagination.html shell/screens/pagination.css shell/screens/toast.html shell/screens/toast.css shell/screens/slider.html shell/screens/slider.css shell/screens/resizable.html shell/screens/resizable.css shell/screens/command.html shell/screens/command.css shell/screens/select.html shell/screens/select.css shell/screens/breadcrumb.html shell/screens/breadcrumb.css shell/screens/menu.html shell/screens/menu.css shell/screens/sheet.html shell/screens/sheet.css shell/screens/form.html shell/screens/form.css shell/screens/table.html shell/screens/table.css shell/screens/data-table.html shell/screens/data-table.css shell/screens/navigation.html shell/screens/navigation.css shell/screens/popover.html shell/screens/popover.css shell/screens/input-otp.html shell/screens/input-otp.css shell/screens/hover-card.html shell/screens/hover-card.css shell/screens/chart.html shell/screens/chart.css shell/screens/atoms.html shell/screens/atoms.css shell/screens/composition.html shell/screens/composition.css shell/screens/chat.html shell/screens/chat.css shell/screens/questionnaire.html shell/screens/questionnaire.css shell/screens/calendar.html shell/screens/calendar.css shell/handlers/flip-of.js shell/handlers/has-nondigit.js shell/handlers/has-prefix.js shell/handlers/is-code.js shell/handlers/is-digits.js shell/handlers/is-key.js shell/handlers/is-printable.js shell/handlers/month-step.js shell/handlers/roll-up.js shell/handlers/starts-with.js shell/handlers/type-into.js shell/handlers/unless-answered.js shell/handlers/unless-typed.js shell/shared/chrome.css brief.html ir.html ir/card.css acceptance.md DESIGN.md robots.txt sitemap.xml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS served_srcs
COPY --from=served_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_bayt_ctxs
